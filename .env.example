# Copy to .env for local development. On Railway set these in Service → Variables.

# MySQL/TiDB connection string
DATABASE_URL=

# Random string (64+ chars). Used to hash client IPs for sessions.
SESSION_SECRET=

# Encrypts uploaded contract scans. Random string (32+ chars). Never change it after scans are uploaded.
FILE_ENCRYPTION_KEY=

# Where uploaded files are stored. On Railway just attach a Volume — it is used automatically.
# STORAGE_DIR=/data

# Contract-scan recognition works out of the box with our own engine (MuPDF + Tesseract, no external service).
# Optionally, an external AI can be used instead by setting ONE of:
#   ANTHROPIC_API_KEY — Claude, console.anthropic.com (API data is not used for training)
#   GEMINI_API_KEY    — Google Gemini, aistudio.google.com (use a paid project for personal data)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OCR_MODEL=          # optional: override the default model

# Optional, legacy Manus Forge (old OCR). Not needed on Railway.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Google sign-in (optional): Drive import AND invoice PDF attached automatically to Gmail drafts.
# Google Cloud → APIs: Gmail API, Google Picker API → OAuth client "Web application", origin = your site address.
# VITE_* values are PUBLIC (they end up in the browser bundle): restrict the API key in Google Cloud
# to your site (HTTP referrers) and to the Picker API only. Never put a server secret into a VITE_ variable.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional: protects POST /api/scheduled/archive-expired-contracts (random 32+ chars)
SCHEDULED_HEARTBEAT_SECRET=

# Optional: extra site addresses allowed to send requests (CSRF check), comma-separated host names.
# Not needed when the app is opened only via its own Railway/custom domain.
# ALLOWED_ORIGINS=usm.example.kz

# Owner account: on every deploy it is created if missing and kept as an active admin.
ADMIN_EMAIL=ayagoz.kulekeyeva@nu.edu.kz
# Set to true for ONE deploy to get a new one-time admin password in the deploy log; then remove.
ADMIN_RESET_PASSWORD=
